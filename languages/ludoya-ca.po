msgstr "Llista"

msgid "Event page (id, slug or URL)"
msgstr "Pàgina de l'esdeveniment (id, slug o URL)"

msgid "Event id (empty reads it from the link)"
msgstr "Id de l'esdeveniment (buit, el llegeix de l'enllaç)"

msgid "Show it"
msgstr "Mostra'l"

msgid "Hide it"
msgstr "Amaga'l"

msgid "How many games"
msgstr "Quants jocs"

msgid "Filter by name"
msgstr "Filtra per nom"

msgid "Grid"
msgstr "Graella"

