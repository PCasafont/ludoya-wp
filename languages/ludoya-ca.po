msgstr "Descripció"

#: templates/admin/event-form.php:199
msgid "Starts"
msgstr "Comença"

#. translators: %s: time zone name.
#: templates/admin/event-form.php:213
#, php-format
msgid "Times are in %s."
msgstr "Les hores són en %s."

#: templates/admin/event-form.php:218
msgid "A sub-event has to fall within its parent's dates."
msgstr "Un subesdeveniment ha de caure dins de les dates del seu esdeveniment principal."

#: templates/admin/event-form.php:225
msgid "Ends"
msgstr "Acaba"

#: templates/admin/event-form.php:238
msgid "Location"
