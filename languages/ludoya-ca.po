msgstr "Espai per a %d"

msgid "Gender"
msgstr "Gènere"

msgid "Date of birth"
msgstr "Data de naixement"

msgid "Phone number"
msgstr "Telèfon"

msgid "This event is full."
msgstr "Aquest esdeveniment és ple."

msgid "Sign up"
msgstr "Inscriu-te"

msgid "Choose…"
msgstr "Tria…"

msgid "Choose at least one option."
msgstr "Tria almenys una opció."

msgid "I agree that my name and email are sent to Ludoya to register my place, and that a Ludoya account is created for me."
msgstr "Accepto que el meu nom i el meu email s'enviïn a Ludoya per registrar la meva plaça, i que se'm creï un compte de Ludoya."

msgid "Leave this field empty"
msgstr "Deixa aquest camp buit"

msgid "Sign me up"
msgstr "Inscriu-me"

msgid "Plays"
msgstr "Partides"

msgid "Different games"
msgstr "Jocs diferents"

