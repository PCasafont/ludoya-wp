msgid_plural "%d seats left"
msgstr[0] "Queda %d plaza"
msgstr[1] "Quedan %d plazas"

msgid "All events"
msgstr "Todos los eventos"

msgid "%1$d of %2$d seats left"
msgstr "Quedan %1$d de %2$d plazas"

