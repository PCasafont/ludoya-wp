msgstr "Límite de peticiones en la última llamada: quedan %1$d de %2$d peticiones este minuto."

#: templates/admin/settings.php:123
msgid "Putting Ludoya on your pages"
msgstr "Poner Ludoya en tus páginas"

#: templates/admin/settings.php:125
